source("/Volumes/LeubnerGroup/AG_Leubner_public_150312/people/Jonathan/Germination assays/2025/2025-01-30 nitrate assay/nitrate germination analysis.R")
ggplot(dfsummary, mapping=aes(x=DAI, y=meancumpercent)) +
geom_errorbar(position=pd, mapping=aes(ymin=meancumpercent-se, ymax=meancumpercent+se, group=`Concentration KNO3 (mM)`), linewidth=.5, width=1) +
geom_line(position=pd, linewidth=.75, aes(color=`Concentration KNO3 (mM)`)) +
geom_point(position=pd, size=2, aes(fill=`Concentration KNO3 (mM)`, shape=`Concentration KNO3 (mM)`), color="black") +
scale_shape_manual(values=c(21,21,21,21))+
#                     breaks=c('water', 'glucose','starch'))+
theme_linedraw() +
theme(text = element_text(size = 20))  +
scale_color_manual(values=met.brewer("VanGogh3", 4, type='continuous'),) +
scale_fill_manual(values=met.brewer("VanGogh3", 4, type='continuous'),) +
#                    breaks=c('Deep','Shallow', "NoTill"),
#labels=c('Naked seeds', 'Intact seeds')
#  ) +
ylab("Coleoptile emergence (%)") +
xlab("Days after imbibition") +
facet_wrap(~seed, nrow=2) +
theme(legend.position="bottom")
