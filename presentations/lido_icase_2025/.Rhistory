ggplot(nitrite_standard, aes(absorbance, concentration)) +
geom_point(color=nitrite_color) +
theme_linedraw(base_size = 26) +
stat_poly_line(color=nitrite_color) +
stat_poly_eq(use_label("eq"), size=6) +
stat_poly_eq(label.y = 0.9, size=6) +
facet_grid(~ion)
ggplot(nitrate_standard, aes(absorbance, concentration)) +
geom_point(color=nitrate_color) +
theme_linedraw(base_size = 26) +
stat_poly_line(color=nitrate_color) +
stat_poly_eq(use_label("eq"), size=6) +
stat_poly_eq(label.y = 0.9, size=6) +
facet_grid(~ion)
all_meas_long %>%
ggplot(aes(as.numeric(as.character(added_nitrate_conc)), measurement, color=seed, shape=ion)) +
geom_point() +
geom_smooth(se=FALSE) +
facet_wrap(~ion) +
scale_x_continuous(trans=scales::pseudo_log_trans(base = 10)) +
scale_y_continuous(trans=scales::pseudo_log_trans(base = 10)) +
theme_classic(base_size=16) +
xlab(teams"added nitrate concentration")
