source("/Volumes/LeubnerGroup/AG_Leubner_public_150312/people/Jonathan/Germination assays/2024/2024-09-30 nitrate/nitrate germination analysis.R")
base <- 16
ggplot(mapping = aes(color=Concentration)) +
geom_line(data = dplyr::filter(tab$plotFits, seed %in% c(13824, 17132)), mapping = aes(x = timeAf, y = CDF)) +
facet_wrap( ~ seed, ncol=5) +
geom_point(data=dplyr::filter(tab$plotPoints, seed %in% c(13824, 17132)), aes(timeAf, CDF)) +
scale_x_continuous(name = "Time (d)") +
scale_y_continuous(name = "Germinated proportion") +
theme_classic(base_size = base) +
scale_color_manual(values=met.brewer("VanGogh3", 4, type='continuous'),) +
labs(color=expression(paste(Concentration~nitrate, ' (mM',~KNO[3], ')' ))) +
theme(legend.position = "bottom")
ggplot(dplyr::filter(PmaxList, seed %in% c(13824, 17132)), aes(concentration, Pmax)) +
geom_point(aes()) +
facet_wrap(~seed, ncol=5) +
scale_x_continuous(trans=scales::pseudo_log_trans(base = 10), breaks=c(0, 2, 10, 20)) +
geom_smooth(method = drm, method.args = list(fct = LL.4()), se = FALSE) +
labs(y=expression(italic(G[max])~'(%)'), x=expression(paste(Concentration~nitrate, ' (mM',~KNO[3], ')' ))) +
theme_classic()
